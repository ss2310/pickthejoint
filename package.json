{
  "name": "pickthejoint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:dev-seed": "tsx scripts/dev-seed.ts",
    "import:handles": "tsx scripts/import-handles.ts",
    "job:ingest": "tsx scripts/jobs/ingest.ts",
    "job:housekeeping": "tsx scripts/jobs/housekeeping.ts",
    "job:enrich": "tsx scripts/jobs/enrich.ts",
    "translate:backfill": "tsx scripts/translate-backfill.ts",
    "census": "tsx scripts/census.ts",
    "railway:release": "npm run db:migrate && npm run db:seed && npm run import:handles -- data/handles-indore.csv --if-empty"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "next": "15.5.29",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
