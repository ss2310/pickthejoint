# Copy to .env.local for local development. Never put real values in this file: it is committed.
DATABASE_URL=postgres://ptj:ptj@localhost:5432/ptj
TEST_DATABASE_URL=postgres://ptj:ptj@localhost:5432/ptj_test
SITE_URL=http://localhost:3000

# Monthly caps (USD). See CLAUDE.md hard rule 1.
SCRAPE_BUDGET_USD=50
MODEL_BUDGET_USD=60
REEL_TRANSCRIPT_BUDGET_USD=3

# Ingestion (Prompt 2)
ANTHROPIC_API_KEY=
APIFY_TOKEN=
# Instagram posts actor, e.g. apify/instagram-scraper (APIFY_ACTOR_ID also works)
APIFY_IG_POSTS_ACTOR_ID=
APIFY_IG_POSTS_FALLBACK_ACTOR_ID=
# Reel transcript actor (APIFY_TRANSCRIPT_ACTOR_ID also works)
APIFY_REEL_TRANSCRIPT_ACTOR_ID=
# Per-result prices for your actors and plan (defaults: 0.0027 and 0.015)
# APIFY_USD_PER_POST=
# APIFY_USD_PER_TRANSCRIPT=

# Google event results through DataForSEO (optional; skipped when unset)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GOOGLE_EVENTS_BUDGET_USD=3

# News roundups: comma-separated source keys to switch on (see docs/sources.md). Empty = off.
NEWS_SOURCES=
NEWS_CALENDARS_BUDGET_USD=5

# Entity enrichment (Prompt 4): monthly limit inside MODEL_BUDGET_USD (default 20); a run uses a quarter of it at most
ENRICHMENT_BUDGET_USD=
# ENRICHMENT_RUN_BUDGET_USD=
# Flags for a one-off run of the enrich job, e.g. "--types venue --limit 5" or "--slugs ohlio"
# ENRICH_ARGS=

# Hindi (Prompt 5): set TRANSLATION=on on the ingest and enrich services so new text is translated as it is created.
# Monthly limit inside MODEL_BUDGET_USD (default 5).
TRANSLATION=
TRANSLATION_BUDGET_USD=

# Site (Prompt 3 and 3b)
# Address shown on the corrections page; also where job alerts go unless ALERT_TO is set
CONTACT_EMAIL=
# Pick the Joint's own profiles, comma-separated URLs (Instagram, YouTube, X, Facebook)
SITE_PROFILES=
# Set to "on" on the Railway job services so changed pages are announced to IndexNow. Leave unset locally.
INDEXNOW=
# Job alerts by email through Resend. ALERT_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
ALERT_FROM=
ALERT_TO=

# Submissions and the admin area (Prompt 6), on the web service
# Cloudflare Turnstile. Without the secret the check is skipped locally and refused in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Salt for hashing visitor addresses for rate limits (defaults to the Turnstile secret)
# IP_HASH_SALT=
# Monthly limit inside MODEL_BUDGET_USD for reading snapped posters and screening submissions (default 3)
SUBMISSIONS_BUDGET_USD=
# One-time admin setup: set a random value of 24+ characters, open /admin/setup?token=<value>,
# choose the password there, then delete this variable. ADMIN_RESET=on (with the token) replaces a password.
ADMIN_SETUP_TOKEN=
# ADMIN_RESET=
# Poster email through Resend inbound (needs RESEND_API_KEY on the web service too)
RESEND_INBOUND_WEBHOOK_SECRET=
# Only mail from these addresses is read (comma-separated; defaults to CONTACT_EMAIL)
POSTER_EMAIL_SENDERS=
# POSTER_EMAIL_CITY=indore

# Natural-language search (Prompt 7), on the web service. Limits inside MODEL_BUDGET_USD for the fast-tier
# readings of queries the rules cannot read: per month (default 3) and per UTC day (default 0.25).
# SEARCH_BUDGET_USD=
# SEARCH_DAILY_BUDGET_USD=

# AI citation tracker (Prompt 8), on the web service: monthly limit inside SCRAPE_BUDGET_USD for the weekly
# GeoGrid runs (default 10). The runs themselves happen on the owner's computer with GeoGrid's own keys.
# CITATIONS_BUDGET_USD=

# Optional overrides of the model IDs in src/config/index.ts
# MODEL_FAST=
# MODEL_MID=
# MODEL_TOP=
