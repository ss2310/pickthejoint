# Copy to .env.local for local development. Never put real values in this file: it is committed.
DATABASE_URL=postgres://ptj:ptj@localhost:5432/ptj
TEST_DATABASE_URL=postgres://ptj:ptj@localhost:5432/ptj_test
SITE_URL=http://localhost:3000

# Monthly caps (USD). See CLAUDE.md hard rule 1.
SCRAPE_BUDGET_USD=50
MODEL_BUDGET_USD=60
REEL_TRANSCRIPT_BUDGET_USD=3

# Ingestion (Prompt 2)
ANTHROPIC_API_KEY=
APIFY_TOKEN=
# Instagram posts actor, e.g. apify/instagram-scraper (APIFY_ACTOR_ID also works)
APIFY_IG_POSTS_ACTOR_ID=
APIFY_IG_POSTS_FALLBACK_ACTOR_ID=
# Reel transcript actor (APIFY_TRANSCRIPT_ACTOR_ID also works)
APIFY_REEL_TRANSCRIPT_ACTOR_ID=
# Per-result prices for your actors and plan (defaults: 0.0027 and 0.015)
# APIFY_USD_PER_POST=
# APIFY_USD_PER_TRANSCRIPT=

# Google event results through DataForSEO (optional; skipped when unset)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GOOGLE_EVENTS_BUDGET_USD=3

# News roundups: comma-separated source keys to switch on (see docs/sources.md). Empty = off.
NEWS_SOURCES=
NEWS_CALENDARS_BUDGET_USD=5

# Site (Prompt 3 and 3b)
# Address shown on the corrections page; also where job alerts go unless ALERT_TO is set
CONTACT_EMAIL=
# Pick the Joint's own profiles, comma-separated URLs (Instagram, YouTube, X, Facebook)
SITE_PROFILES=
# Set to "on" on the Railway job services so changed pages are announced to IndexNow. Leave unset locally.
INDEXNOW=
# Job alerts by email through Resend. ALERT_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
ALERT_FROM=
ALERT_TO=

# Optional overrides of the model IDs in src/config/index.ts
# MODEL_FAST=
# MODEL_MID=
# MODEL_TOP=
